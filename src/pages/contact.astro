---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
---

<BaseLayout
  title="Contact"
  description="Connect with CoreFour Advisors. Schedule a call to discuss AI diligence for your next Private Equity deal."
>
  <!-- Hero -->
  <section class="page-hero" style="background-image: url('/images/heroes/contact-hero.svg');">
    <div class="container">
      <p class="hero-eyebrow">GET IN TOUCH</p>
      <h1>Let's Talk About Your Deal</h1>
      <p class="hero-subtitle">
        First conversation is always on us. No pitch, no pressure—just an honest discussion about whether we can help.
      </p>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="section">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-info">
          <h2>Start a Conversation</h2>
          <p>
            Whether you're in active diligence or just exploring options, we're happy to discuss how AI validation fits into your process.
          </p>

          <div class="contact-methods">
            <div class="contact-method">
              <h3>Email</h3>
              <a href="mailto:hello@corefouradvisors.com">hello@corefouradvisors.com</a>
            </div>

            <div class="contact-method">
              <h3>Response Time</h3>
              <p>We respond within 24 hours on business days.</p>
            </div>
          </div>

          <div class="what-to-expect">
            <h3>What to Expect</h3>
            <ul>
              <li>30-minute introductory call</li>
              <li>Discussion of your deal context (under NDA if needed)</li>
              <li>Honest assessment of whether we can add value</li>
              <li>No obligation, no follow-up sales pressure</li>
            </ul>
          </div>
        </div>

        <div class="contact-form">
          <LeadForm
            formId="contact-form"
            title="Send a Message"
            submitText="Send Message"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <p class="section-eyebrow">FREQUENTLY ASKED</p>
        <h2>Common Questions</h2>
      </div>
      <div class="faq-grid">
        <div class="faq-item">
          <h3>What information do you need to get started?</h3>
          <p>
            For an initial conversation, just a brief description of the target company and the AI claims you want to validate. We can work under NDA from the first call.
          </p>
        </div>
        <div class="faq-item">
          <h3>How quickly can you start an engagement?</h3>
          <p>
            We maintain capacity for deal-timeline work. For most engagements, we can start within 48-72 hours of signed SOW.
          </p>
        </div>
        <div class="faq-item">
          <h3>Do you work with the target company directly?</h3>
          <p>
            Yes, but always through you. We coordinate data requests and technical interviews through the deal team to maintain appropriate boundaries.
          </p>
        </div>
        <div class="faq-item">
          <h3>What if you find the AI claims are not valid?</h3>
          <p>
            We report honestly. A "no-go" recommendation is just as valuable as validation—it prevents a bad investment thesis. We're paid for truth, not optimism.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 5rem 1.5rem;
    background-color: var(--color-secondary);
    background-size: cover;
    background-position: center;
    text-align: center;
    color: white;
  }

  .page-hero h1 {
    color: white;
  }

  .hero-eyebrow {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-gold);
    margin-bottom: 1rem;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--color-text-light);
    max-width: 600px;
    margin: 1rem auto 0;
  }

  .section-eyebrow {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--color-gold);
    margin-bottom: 0.75rem;
  }

  /* Contact Grid */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 4rem;
  }

  .contact-info h2 {
    margin-bottom: 1rem;
  }

  .contact-info > p {
    color: var(--color-text-light);
    margin-bottom: 2rem;
    line-height: 1.7;
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .contact-method h3 {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-light);
    margin-bottom: 0.5rem;
  }

  .contact-method a {
    font-size: 1.125rem;
    color: var(--color-primary);
  }

  .contact-method a:hover {
    color: var(--color-primary-dark);
  }

  .contact-method p {
    color: var(--color-text);
    font-size: 1rem;
    margin: 0;
  }

  .what-to-expect h3 {
    font-size: 1rem;
    margin-bottom: 1rem;
    color: var(--color-secondary);
  }

  .what-to-expect ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .what-to-expect li {
    padding: 0.5rem 0;
    padding-left: 1.5rem;
    position: relative;
    color: var(--color-text);
  }

  .what-to-expect li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-primary);
  }

  .contact-form {
    background: white;
    padding: 2.5rem;
    border-radius: 1rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    border: 1px solid var(--color-border);
  }

  /* FAQ */
  .faq-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .faq-item {
    background: white;
    padding: 2rem;
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
  }

  .faq-item h3 {
    font-size: 1.125rem;
    margin-bottom: 0.75rem;
  }

  .faq-item p {
    color: var(--color-text-light);
    margin: 0;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .contact-form {
      padding: 1.5rem;
    }

    .faq-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
