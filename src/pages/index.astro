---
import BaseLayout from '../layouts/BaseLayout.astro';

const stats = [
  { value: '70%', label: 'of CIMs mention AI' },
  { value: '<10%', label: 'have real capability' },
  { value: '5-7', label: 'days to clarity' },
  { value: '200-400', label: 'bps EBITDA potential' }
];

const differentiators = [
  {
    title: 'Deep Operator Bench',
    description: 'We speak IRR, not APIs. Every deliverable is designed for the IC memo.',
    icon: '/images/icons/differentiators/deep-operator-bench.svg'
  },
  {
    title: 'Code, Not Decks',
    description: 'We build working prototypes, not slide decks. Code over concepts.',
    icon: '/images/icons/differentiators/code-not-decks.svg'
  },
  {
    title: 'Radical Neutrality',
    description: 'Every recommendation is backed by a functional prototype with real data.',
    icon: '/images/icons/differentiators/radical-neutrality.svg'
  },
  {
    title: 'Deal-Speed Delivery',
    description: '5-15 days, not 6-month roadmaps. We operate in deal time.',
    icon: '/images/icons/differentiators/deal-speed.svg'
  }
];
---

<BaseLayout
  title="Home"
  description="CoreFour Advisors provides AI diligence for Private Equity deal teams. Replace technical speculation with operational certainty in 5-15 days."
>
  <!-- Hero Section -->
  <section class="hero" style="background-image: url('/images/heroes/homepage-hero.svg');">
    <div class="container">
      <div class="hero-content">
        <p class="hero-eyebrow">AI DILIGENCE FOR PRIVATE EQUITY</p>
        <h1>Replace Technical Speculation with <span class="highlight">Operational Certainty</span></h1>
        <p class="hero-subtitle">
          Every deal now has an AI story. Deal teams lack the expertise to validate it. We provide PE-native answers in deal time.
        </p>
        <div class="hero-cta">
          <a href="/contact" class="btn btn-primary">Schedule a Call</a>
          <a href="/services" class="btn btn-secondary">View Offerings</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="stats section-dark">
    <div class="container">
      <div class="stats-grid">
        {stats.map(stat => (
          <div class="stat-item">
            <span class="stat-value">{stat.value}</span>
            <span class="stat-label">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Problem Section -->
  <section class="section">
    <div class="container">
      <div class="problem-grid">
        <div class="problem-content">
          <p class="section-eyebrow">THE PROBLEM</p>
          <h2>AI Claims Are Everywhere. Validation Is Rare.</h2>
          <p>
            Management teams are incentivized to overstate AI capabilities. Technical consultants speak in jargon, not margin impact. Deal teams are left guessing whether "proprietary AI" means competitive moat or PowerPoint fiction.
          </p>
          <div class="problem-list">
            <div class="problem-item">
              <span class="status-indicator stop"></span>
              <span>"We have AI" could mean anything from GPT wrappers to genuine capabilities</span>
            </div>
            <div class="problem-item">
              <span class="status-indicator stop"></span>
              <span>Technical diligence reports are unreadable by non-engineers</span>
            </div>
            <div class="problem-item">
              <span class="status-indicator stop"></span>
              <span>No standard framework for AI value creation assessment</span>
            </div>
          </div>
        </div>
        <div class="problem-visual">
          <div class="problem-card">
            <h4>The Question Every Deal Team Asks:</h4>
            <p class="big-quote">"Is this real?"</p>
            <p class="caption">We answer it with code, not conjecture.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Solution Section -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <p class="section-eyebrow">THE SOLUTION</p>
        <h2>Two Phases. Complete Clarity.</h2>
        <p>From initial diligence to proof of concept, we provide defensible answers in deal time.</p>
      </div>
      <div class="phases-grid">
        <div class="phase-card">
          <img src="/images/icons/services/phase1-reality-check.svg" alt="AI Reality Check" class="phase-icon" />
          <span class="phase-number">01</span>
          <h3>AI Reality Check</h3>
          <p class="phase-price">$75,000 | 5-7 Days</p>
          <p>Four questions answered with IC-ready documentation:</p>
          <ul>
            <li>Is the AI claim real or vapor?</li>
            <li>What's the true technical maturity?</li>
            <li>What margin improvement is realistic?</li>
            <li>What are the implementation risks?</li>
          </ul>
          <a href="/services" class="btn btn-secondary">Learn More</a>
        </div>
        <div class="phase-card featured">
          <span class="phase-badge">MOST POPULAR</span>
          <img src="/images/icons/services/phase2-proof-of-concept.svg" alt="Proof of Concept" class="phase-icon" />
          <span class="phase-number">02</span>
          <h3>Proof of Concept</h3>
          <p class="phase-price">$125,000 | 10-15 Days</p>
          <p>Working prototype that proves feasibility:</p>
          <ul>
            <li>Functional prototype with target's real data</li>
            <li>100-day implementation roadmap</li>
            <li>5 detailed opportunity profiles</li>
            <li>Quantified margin improvement model</li>
          </ul>
          <a href="/services" class="btn btn-primary">Learn More</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Why CoreFour Section -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <p class="section-eyebrow">WHY COREFOUR</p>
        <h2>Four Disciplines. One Answer.</h2>
        <p>We combine Private Equity, AI Engineering, UX Design, and Operations expertise to deliver defensible recommendations.</p>
      </div>
      <div class="grid grid-4">
        {differentiators.map(item => (
          <div class="card">
            <img src={item.icon} alt={item.title} class="card-icon" />
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section section section-dark">
    <div class="container">
      <div class="cta-content text-center">
        <h2>Ready for Operational Certainty?</h2>
        <p>Let's discuss your next deal. First conversation is always free.</p>
        <a href="/contact" class="btn btn-white">Start a Conversation</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding: 6rem 1.5rem 5rem;
    background-color: var(--color-background-alt);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .hero-content {
    max-width: 800px;
  }

  .hero-eyebrow {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-gold);
    margin-bottom: 1rem;
  }

  .hero h1 {
    margin-bottom: 1.5rem;
  }

  .highlight {
    color: var(--color-gold);
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--color-text-light);
    margin-bottom: 2rem;
    max-width: 600px;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Stats */
  .stats {
    padding: 3rem 1.5rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    text-align: center;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-gold);
  }

  .stat-label {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Section Eyebrow */
  .section-eyebrow {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--color-gold);
    margin-bottom: 0.75rem;
  }

  /* Problem Section */
  .problem-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .problem-content h2 {
    margin-bottom: 1.5rem;
  }

  .problem-content > p {
    color: var(--color-text-light);
    font-size: 1.125rem;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .problem-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .problem-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .status-indicator {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-top: 0.4rem;
    flex-shrink: 0;
  }

  .status-indicator.stop {
    background: var(--status-stop);
  }

  .status-indicator.go {
    background: var(--status-go);
  }

  .problem-item span:last-child {
    color: var(--color-text);
    line-height: 1.5;
  }

  .problem-card {
    background: var(--color-secondary);
    color: white;
    padding: 2.5rem;
    border-radius: 1rem;
    text-align: center;
  }

  .problem-card h4 {
    color: rgba(255, 255, 255, 0.7);
    font-size: 1rem;
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .big-quote {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: white;
  }

  .caption {
    color: var(--color-gold);
    font-size: 0.9375rem;
    margin: 0;
  }

  /* Phases */
  .phases-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .phase-card {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 2.5rem;
    position: relative;
  }

  .phase-icon {
    width: 60px;
    height: 60px;
    margin-bottom: 0.5rem;
  }

  .phase-card.featured {
    border: 2px solid var(--color-primary);
    box-shadow: 0 10px 40px rgba(59, 130, 246, 0.15);
  }

  .phase-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-primary);
    color: white;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 1rem;
    border-radius: 1rem;
    letter-spacing: 0.05em;
  }

  .phase-number {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 700;
    color: var(--color-background-alt);
    display: block;
    margin-bottom: 0.5rem;
  }

  .phase-card h3 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .phase-price {
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .phase-card > p:not(.phase-price) {
    color: var(--color-text-light);
    margin-bottom: 1rem;
  }

  .phase-card ul {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
  }

  .phase-card li {
    padding: 0.5rem 0;
    padding-left: 1.5rem;
    position: relative;
    color: var(--color-text);
    font-size: 0.9375rem;
  }

  .phase-card li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-primary);
  }

  /* Cards */
  .card {
    text-align: center;
  }

  .card-icon {
    width: 64px;
    height: 64px;
    margin-bottom: 1rem;
  }

  .card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
    color: var(--color-secondary);
  }

  .card p {
    color: var(--color-text-light);
    margin-bottom: 0;
  }

  /* CTA Section */
  .cta-section {
    text-align: center;
  }

  .cta-content h2 {
    margin-bottom: 1rem;
  }

  .cta-content p {
    font-size: 1.125rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 4rem 1rem;
    }

    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .problem-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .phases-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
